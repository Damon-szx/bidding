BIDDING_DATA_DIR=./data
# Leave empty for SQLite. MySQL database must already exist.
DATABASE_URL=
# DATABASE_URL=mysql+pymysql://bidding:YOUR_PASSWORD@localhost:3306/bidding?charset=utf8mb4
# OpenAI-compatible chat completions endpoint, including /v1 if needed.
MODEL_PROVIDER=deepseek
# Qwen uses its own credentials; MODEL_* below retains the DeepSeek channel.
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_NAME=qwen3.7-flash
QWEN_API_KEY=
QWEN_THINKING=disabled
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=
# DeepSeek defaults to disabled here; enabled mode retains reasoning_content.
MODEL_THINKING=disabled
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_OUTPUT_TOKENS=2048
TASK_TIMEOUT_SECONDS=600
TASK_TOKEN_BUDGET=300000
TASK_TOKEN_BUDGET_MODE=soft
TASK_TOKEN_HARD_LIMIT=1000000
TASK_TOKEN_GRACE_TOKENS=15000
AGENT_MAX_ROUNDS=24
AGENT_NO_PROGRESS_ROUNDS=3
AGENT_MAX_RECOVERY_ROUNDS=3
AGENT_MAX_TOOL_CALLS=48
# Transport attempts are separate from logical calls. Three attempts include the first call.
AGENT_MAX_TOOL_ATTEMPTS=72
AGENT_MAX_DELEGATIONS=6
SPECIALIST_MAX_ROUNDS=5
COORDINATOR_MAX_EVIDENCE_READS=2
REFLECTION_ENABLED=true
REFLECTION_MAX_ROUNDS=2
TOOL_MAX_ATTEMPTS=3
MODEL_MAX_ATTEMPTS=3
TOOL_TIMEOUT_SECONDS=90
RETRY_BASE_SECONDS=0.5
TOOL_RESULT_MAX_TOKENS=2000
TOOL_SUMMARY_MAX_CHUNKS=3
CONTEXT_COMPACT_THRESHOLD_TOKENS=24000
CONTEXT_MIN_COMPACTION_GAIN_TOKENS=2000
# blocks：长详情先返回内容目录；legacy：恢复原正文开头预览。
PAGE_CONTENT_MODE=blocks
CONTEXT_HARD_LIMIT_TOKENS=32000
# For a verified long-context endpoint, e.g. current official deepseek-flash:
# CONTEXT_HARD_LIMIT_TOKENS=128000
# CONTEXT_COMPACT_THRESHOLD_TOKENS=64000
CONTEXT_KEEP_RECENT_TURNS=2
CONTEXT_RECENT_EXCHANGES=4
SUMMARY_MAX_TOKENS=1500
SUMMARY_INPUT_MAX_TOKENS=8000
# A real search MCP service using Streamable HTTP.
SEARCH_MCP_URL=
SEARCH_MCP_TOKEN=
SEARCH_MCP_TOOL=web_search
# Change this if the service expects q instead of query.
SEARCH_MCP_QUERY_FIELD=query
AGENT_MAX_SEARCH_CALLS=6
SEARCH_MAX_EXTENSIONS=3
SEARCH_EXTENSION_CALLS=2
SEARCH_RESERVED_TOKENS=8000
# Use chrome for an installed Google Chrome, or leave blank for Playwright Chromium.
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT_SECONDS=40
BROWSER_MAX_PAGES=32
# Persisted batch downloads; independent of the dialogue/model budgets.
BATCH_CONCURRENCY=2
BATCH_TIMEOUT_SECONDS=1800
BATCH_MAX_BYTES=2147483648
